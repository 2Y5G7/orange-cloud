{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Worker 名称，自己起一个即可，会体现在 *.workers.dev 域名和 Dashboard 里。
	"name": "oc",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets",
		// 默认的 "auto-trailing-slash" 会把 /x.html 302/307 到 /x，
		// 导致百度站长的验证文件（要求 .html 原样 200）拿不到内容。
		// 本站静态资源里唯一的 .html 就是站长验证文件，关掉这层改写最省事。
		// 如果你没有百度站长验证文件，这个可以删掉或保留，不影响其他功能。
		"html_handling": "none"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		// 这个不涉及具体账号资源，无需修改。
		"binding": "IMAGES"
	},

	// ============ 必须替换：D1 数据库 ============
	// App Store Server Notifications V2 的后台账本（订阅 / 财务）。
	// 部署前先在你自己的 Cloudflare 账号下执行：
	//   wrangler login
	//   wrangler d1 create orange-cloud-iap
	// 命令会返回一个 database_id，把它填到下面。
	// 之后执行：wrangler d1 migrations apply orange-cloud-iap --remote
	// 本地开发 / 测试用 --local，placeholder id 即可，不联网。
	// 如果你不需要 App Store 订阅/退款相关功能，可以把整个 d1_databases 数组删掉，
	// 但要确认代码里没有强依赖这个绑定（否则运行时会报错）。
	"d1_databases": [
		{
			"binding": "IAP_DB",
			"database_name": "orange-cloud-iap",
			"database_id": "2a6c122f-3468-42a0-8f28-5c78385ce7c2",
			"migrations_dir": "migrations",
			"remote": true
		}
	],

	// ============ 可选：邮件发送 ============
	// Cloudflare Email Service（Email Sending）—— 发激活码邮件，绑定式、无需 API key。
	// 发件域名须先在你自己账号下 onboard：
	//   wrangler email sending enable <你的发件域名>
	// 如果不需要发邮件功能，直接删掉这一整段（前提是代码对未绑定时有降级处理，
	// 建议先搜一下代码里怎么用这个 EMAIL 绑定，确认删掉不会导致报错）。
	"send_email": [
		{
			"name": "EMAIL"
		}
	],

	// ISR 页面缓存（open-next.config.ts 的 r2IncrementalCache）。
	// deploy 时 opennextjs-cloudflare 会把预渲染产物灌进这个桶。
	// bucket_name 不是必须跟原作者一样，但需要先创建：
	//   wrangler r2 bucket create <你起的桶名>
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "<替换成你自己的-r2-桶名，比如 my-orange-cloud-cache>"
		}
	],

	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			// 这个 service 名必须和上面的 "name" 字段保持一致（自引用）。
			"binding": "WORKER_SELF_REFERENCE",
			"service": "<必须和最上面的-name-字段填一样的值>"
		}
	],

	"observability": {
		"enabled": true
	},

	// custom-worker.ts 的 scheduled() 按 cron 分派：
	//   "0 8 * * *"    每天 UTC 08:00 抓 App Store 各地区榜单名次 + IndexNow
	//   "*/30 * * * *" 每 30 分钟兜底发送 Apple 退款申请的消费信息（12h 截止）
	// 不涉及具体账号资源，如果不需要这些定时任务对应的功能，可以删掉整个 triggers 段
	// （同样建议先确认代码里 scheduled() 逻辑没有其他地方依赖它被触发）。
	"triggers": {
		"crons": [
			"0 8 * * *",
			"*/30 * * * *"
		]
	},

	// ============ 可选：Apple App Store Server API ============
	// 用于内购订阅通知 / 退款审核的消费信息上报。key id / issuer id 本身不是机密，
	// 但对应你自己 App Store Connect 账号下的应用，别人的填了对你没用。
	// 私钥单独走 secret，不写在这个文件里：
	//   wrangler secret put APPLE_IAP_PRIVATE_KEY   （粘贴 .p8 私钥原文）
	// 获取方式：App Store Connect → 用户和访问 → 密钥 → App Store Server API 密钥。
	// 如果不需要 iOS 内购/退款审核功能，把整个 vars 块删掉即可（若代码没有强依赖）。
	"vars": {
		"APPLE_IAP_KEY_ID": "<替换成你自己的-Apple-Key-ID，或删掉整个vars块>",
		"APPLE_IAP_ISSUER_ID": "<替换成你自己的-Apple-Issuer-ID，或删掉整个vars块>"
	},

	// ============ 必须替换：自定义域名 ============
	// custom_domain: true 要求该域名已经加入你自己的 Cloudflare 账号（DNS 托管在 Cloudflare）。
	// 如果你暂时没有自己的域名，可以把整个 routes 数组删掉：
	// 部署后会用 Cloudflare 分配的默认 <name>.<你的子域>.workers.dev 访问，
	// 之后有域名了再加回来即可。
	"routes": [
		{
			"pattern": "oc.2507.cc.cd",
			"custom_domain": true
		}
		// 如果还有其他域名/子域名要绑定，照这个格式再加几条即可，比如 www 子域名：
		// {
		// 	"pattern": "www.<你的域名>",
		// 	"custom_domain": true
		// }
	]
}
